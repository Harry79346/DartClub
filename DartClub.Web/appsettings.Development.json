{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // LocalDB-Instanzname: (localdb)\MSSQLLocalDB
    // Database: "DartClub" (wird automatisch erzeugt bei Migration)
