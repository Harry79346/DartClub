    // MARS: mehrere aktive Resultsets erlaubt (z. B. für Migrations-Skripte)
    "Default": "Server=(localdb)\\mssqllocaldb;Database=DartClub;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}
